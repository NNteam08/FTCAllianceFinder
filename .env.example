# Supabase (обязательно для авторизации и БД)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Supabase Service Role — для загрузки файлов и админ-действий
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# FTCScout API (опционально; по умолчанию используется https://api.ftcscout.org/rest/v1)
# FTCSCOUT_API_URL=https://api.ftcscout.org/rest/v1

# FIRST FTC Events API — при наличии используется вместо FTCScout для quick-stats
# Регистрация: https://ftc-events.firstinspires.org/services/API/register
# FIRST_FTC_API_USERNAME=your_username
# FIRST_FTC_API_TOKEN=your_token

# OpenAI — для AI-анализа альянса (кнопка «Получить анализ ИИ» на странице сравнения)
# OPENAI_API_KEY=sk-...
