# Supabase — подключение к вашей БД. Отсюда приложение читает/пишет teams, quick_stats, events и т.д.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# FTCScout API (необязательно). Если не задано — используется https://api.ftcscout.org/rest/v1
# Нужно только если хостите свой прокси или другой URL.
# FTCSCOUT_API_URL=https://api.ftcscout.org/rest/v1

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000




